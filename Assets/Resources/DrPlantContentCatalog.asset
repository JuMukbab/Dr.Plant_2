  dialogues:
    arrival:
    - "\uC548\uB155\uD558\uC138\uC694!"
    - "\uC548\uB155\uC694."
    - "\uC798 \uBD80\uD0C1\uB4DC\uB824\uC694."
    - "\uC120\uC0DD\uB2D8, \uC548\uB155\uD558\uC138\uC694."
    - "\uC624\uB298 \uC9C4\uB8CC \uC798 \uBD80\uD0C1\uB4DC\uB9B4\uAC8C\uC694."
    - "\uC800 \uC654\uC5B4\uC694!"
    - "\uC5EC\uAE30\uAC00 Dr.Plant \uB9DE\uC8E0?"
    - "\uCC98\uC74C \uBD59\uACA0\uC2B5\uB2C8\uB2E4."
    - "\uC120\uC0DD\uB2D8\uAED8 \uC9C4\uB8CC\uBC1B\uC73C\uB7EC \uC654\uC5B4\uC694."
    - "\uC798 \uBD80\uD0C1\uB4DC\uB824\uC694."
    normal:
    - "\uC624\uB298 \uB0A0\uC528\uAC00 \uC88B\uB124\uC694... \uADF8\uCE58\uC694?"
    - "\uC800 \uC870\uAE08 \uAE34\uC7A5\uD588\uC5B4\uC694."
    - "\uC5EC\uAE30 \uBCD1\uC6D0 \uB9DE\uC8E0...?"
    - "\uC120\uC0DD\uB2D8\uC740 \uC5B4\uB5A4 \uC2DD\uBB3C\uC744 \uC88B\uC544\uD558\uC138\uC694?"
    - "\uBB34\uC2A8 \uCE58\uB8CC\uB97C \uD558\uC2E4 \uAC74\uAC00\uC694?"
    goodReviews:
    - "\uC774\uC81C \uAD1C\uCC2E\uC544\uC84C\uC5B4\uC694!"
    - "\uC815\uD655\uD55C \uCE58\uB8CC\uC600\uC5B4\uC694. \uAC10\uC0AC\uD569\uB2C8\uB2E4!"
    - "\uBAB8\uC774 \uD55C\uACB0 \uAC00\uBCBC\uC6CC\uC84C\uC5B4\uC694!"
    - "\uC120\uC0DD\uB2D8, \uC5ED\uC2DC \uBBFF\uACE0 \uC788\uC5C8\uC5B4\uC694!"
    - "\uC774\uC81C \uB2E4\uC2DC \uAC74\uAC15\uD574\uC9C8 \uC218 \uC788\uC744 \uAC83
      \uAC19\uC544\uC694."
    - "\uB2E4\uC74C\uC5D0\uB3C4 \uC5EC\uAE30\uB85C \uC62C\uAC8C\uC694!"
    badReviews:
    - "\uAE30\uBD84\uC774 \uB9CE\uC774 \uC0C1\uD588\uC5B4\uC694..."
    - "\uC774\uAC70 \uB3CC\uD314\uC774 \uC544\uB2C8\uC57C?"
    - "\uC804\uBCF4\uB2E4 \uB354 \uC544\uD508 \uAC83 \uAC19\uC740\uB370\uC694..."
    - "\uC815\uB9D0 \uC774 \uCE58\uB8CC\uAC00 \uB9DE\uB294 \uAC74\uAC00\uC694?"
    - "\uB2E4\uC74C\uC5D0\uB294 \uB2E4\uB978 \uBCD1\uC6D0\uC5D0 \uAC08\uB798\uC694."
    - "\uC120\uC0DD\uB2D8... \uC81C \uB9D0\uC744 \uB4E3\uAE34 \uD55C \uAC70\uC8E0?"
    - "\uC774\uAC74 \uC81C\uAC00 \uC6D0\uD55C \uCE58\uB8CC\uAC00 \uC544\uB2C8\uC5D0\uC694!"
