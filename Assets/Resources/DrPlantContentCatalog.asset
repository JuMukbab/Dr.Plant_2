  symptoms:
  - id: 1
    displayName: "\uC218\uBD84 \uBD80\uC871"
    acceptedTreatments: 01000000
    requiredShopItem: 0
    incompatibleSymptoms: 
    dialogues:
    - "\uBAA9\uC774 \uB108\uBB34 \uB9D0\uB77C\uC694..."
    - "\uD759\uC774 \uBC14\uC2F9 \uB9D0\uB77C\uBC84\uB9B0 \uAC83 \uAC19\uC544\uC694."
    - "\uBB3C\uC744 \uB9C8\uC2E0 \uC9C0 \uB108\uBB34 \uC624\uB798\uB410\uC5B4\uC694..."
    - "\uC78E\uC5D0 \uD798\uC774 \uD558\uB098\uB3C4 \uC5C6\uC5B4\uC694."
    - "\uD759\uC774 \uC810\uC810 \uB531\uB531\uD574\uC9C0\uACE0 \uC788\uC5B4\uC694..."
  - id: 2
    displayName: "\uACE0\uC628"
    acceptedTreatments: 0200000007000000
    requiredShopItem: 0
    incompatibleSymptoms: 03000000
    dialogues:
    - "\uBAB8\uC774 \uB108\uBB34 \uB728\uAC70\uC6CC\uC694..."
    - "\uC78E \uB05D\uC774 \uB728\uAC81\uAC8C \uB2EC\uC544\uC624\uB978 \uAC83 \uAC19\uC544\uC694."
    - "\uC870\uAE08 \uC2DC\uC6D0\uD55C \uACF3\uC73C\uB85C \uAC00\uACE0 \uC2F6\uC5B4\uC694."
    - "\uC624\uB298\uB530\uB77C \uD587\uBE5B\uC774 \uB108\uBB34 \uB530\uAC00\uC6CC\uC694."
    - "\uBAB8\uC5D0\uC11C \uACC4\uC18D \uC5F4\uC774 \uB098\uB294 \uAE30\uBD84\uC774\uC5D0\uC694..."
  - id: 3
    displayName: "\uC800\uC628"
    acceptedTreatments: 03000000
    requiredShopItem: 0
    incompatibleSymptoms: 02000000
    dialogues:
    - "\uBAB8\uC774 \uC790\uAFB8 \uB35C\uB35C \uB5A8\uB824\uC694..."
    - "\uBFCC\uB9AC\uAE4C\uC9C0 \uC5BC\uC5B4\uBD99\uB294 \uAC83 \uAC19\uC544\uC694."
    - "\uC870\uAE08 \uB354 \uB530\uB73B\uD55C \uACF3\uC740 \uC5C6\uB098\uC694?"
    - "\uD654\uBD84 \uC548\uAE4C\uC9C0 \uB108\uBB34 \uCC28\uAC00\uC6CC\uC84C\uC5B4\uC694."
    - "\uB530\uB73B\uD55C \uD587\uBE5B\uC774 \uADF8\uB9AC\uC6CC\uC694..."
  - id: 4
    displayName: "\uC601\uC591 \uBD80\uC871"
    acceptedTreatments: 04000000
    requiredShopItem: 0
    incompatibleSymptoms: 
    dialogues:
    - "\uBB3C\uC744 \uB9C8\uC154\uB3C4 \uACC4\uC18D \uAE30\uC6B4\uC774 \uC5C6\uC5B4\uC694..."
    - "\uC694\uC998 \uC0C8\uC78E\uC774 \uC798 \uC790\uB77C\uC9C0 \uC54A\uC544\uC694."
    - "\uBAB8\uC5D0 \uD544\uC694\uD55C \uAC8C \uBD80\uC871\uD55C \uAC83 \uAC19\uC544\uC694."
    - "\uCDA9\uBD84\uD788 \uC26C\uC5C8\uB294\uB370\uB3C4 \uD798\uC774 \uB098\uC9C0
      \uC54A\uC544\uC694."
    - "\uC78E \uC0C9\uC774 \uC804\uBCF4\uB2E4 \uC605\uC5B4\uC9C4 \uAC83 \uAC19\uC544\uC694..."
  - id: 5
    displayName: "\uC9C0\uB8E8\uD568"
    acceptedTreatments: 05000000
    requiredShopItem: 1
    incompatibleSymptoms: 
    dialogues:
    - "\uC800 \uB108\uBB34 \uC9C0\uB8E8\uD574\uC694..."
    - "\uC624\uB298\uB3C4 \uC544\uBB34 \uC77C\uB3C4 \uC5C6\uB124\uC694."
    - "\uB204\uAC00 \uC74C\uC545\uC774\uB77C\uB3C4 \uB4E4\uB824\uC92C\uC73C\uBA74
      \uC88B\uACA0\uC5B4\uC694."
    - "\uBCBD \uBB34\uB2AC\uB97C \uC138\uB294 \uAC83\uB3C4 \uC774\uC81C \uC9C0\uACA8\uC6CC\uC694."
    - "\uC2E0\uB098\uB294 \uB178\uB798 \uAC19\uC740 \uAC74 \uC5C6\uB098\uC694?"
    - "\uACC4\uC18D \uAC00\uB9CC\uD788 \uC788\uC73C\uB2C8\uAE4C \uB108\uBB34 \uC2EC\uC2EC\uD574\uC694..."
  - id: 6
    displayName: "\uACFC\uB3C4\uD55C \uC78E"
    acceptedTreatments: 06000000
    requiredShopItem: 2
    incompatibleSymptoms: 
    dialogues:
    - "\uBD88\uD544\uC694\uD55C \uC78E\uB4E4\uC774 \uB108\uBB34 \uB9CE\uC544\uC84C\uC5B4\uC694..."
    - "\uC78E\uC774 \uB108\uBB34 \uBB34\uC131\uD574\uC11C \uC6C0\uC9C1\uC774\uAE30
      \uD798\uB4E4\uC5B4\uC694."
    - "\uBAB8\uC774 \uB108\uBB34 \uBCF5\uC7A1\uD558\uACE0 \uB2F5\uB2F5\uD574\uC694."
    - "\uC774 \uC624\uB798\uB41C \uC78E\uB4E4\uC744 \uC815\uB9AC\uD574\uC57C \uD560
      \uAC83 \uAC19\uC544\uC694."
    - "\uC0C8\uC78E\uC774 \uC790\uB784 \uACF5\uAC04\uC774 \uC5C6\uB294 \uAC83 \uAC19\uC544\uC694."
    - "\uC120\uC0DD\uB2D8, \uC870\uAE08 \uB2E4\uB4EC\uC5B4\uC8FC\uC2E4 \uC218 \uC788\uB098\uC694?"
